include README.md LICENSE NOTICE CITATION.cff .env.example .gitignore
recursive-include docs *.md
recursive-include src *.py *.txt *.json
recursive-include eval *.py *.json *.txt *.md
recursive-include examples *.py *.md
recursive-include tests *.py
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.egg-info
