include README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md CITATION.cff release_manifest.json .env.example .gitignore
recursive-include docs *.md
recursive-include configs *.yaml *.py
recursive-include src *.py *.txt *.json
recursive-include eval *.py *.json *.txt *.md *.upstream
recursive-include reproduce *.py *.md
recursive-include scripts/datasets *.py *.md *.sha256 *.json
recursive-include viewer *.py *.html *.js *.css *.svg *.json *.md *.png *.mp4
recursive-include tools *.py
recursive-include examples *.py *.md *.png
recursive-include tests *.py
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.egg-info
