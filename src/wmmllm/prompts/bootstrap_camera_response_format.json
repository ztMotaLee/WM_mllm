{
  "type": "json_schema",
  "json_schema": {
    "name": "reachable_camera_schedule",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "camera_path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "segment": {
                "type": "integer"
              },
              "yaw": {
                "type": "number"
              },
              "pitch": {
                "type": "number"
              }
            },
            "required": [
              "segment",
              "yaw",
              "pitch"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "camera_path"
      ],
      "additionalProperties": false
    }
  }
}
