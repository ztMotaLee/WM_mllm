# Copy to a local file and select it explicitly with --env-file.
# Process environment values take precedence. Never commit your filled file.
WMM_LLM_API_KEY=
WMM_LLM_BASE_URL=https://api.openai.com/v1
WMM_LLM_MODEL=
WMM_LLM_ORGANIZATION=
WMM_LLM_PROJECT=

# Each blank image field inherits its matching LLM field independently.
WMM_IMAGE_API_KEY=
WMM_IMAGE_BASE_URL=
WMM_IMAGE_MODEL=
WMM_IMAGE_ORGANIZATION=
WMM_IMAGE_PROJECT=
