{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared world viewer v1",
  "description": "SPDX-License-Identifier: Apache-2.0. Panorama previews and accepted endpoints with a prepared playback graph. Graph references, unique IDs, acyclic parents and rectangle consistency are checked by the viewer and exporter.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "wmmllm.world.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "procedural_fixture": {
      "type": "boolean"
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "initial_node_id": {
      "type": "string",
      "pattern": "^n[0-9]{4,}$"
    },
    "current_node_id": {
      "type": "string",
      "pattern": "^n[0-9]{4,}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "procedural_fixture",
    "attribution",
    "initial_node_id",
    "current_node_id",
    "nodes",
    "actions"
  ],
  "$defs": {
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "hfov": {
          "type": "number",
          "minimum": 1,
          "maximum": 179
        }
      },
      "required": [
        "yaw",
        "pitch",
        "hfov"
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "content_box": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          },
          "minItems": 4,
          "maxItems": 4
        },
        "padding_ltrb": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "width",
        "height",
        "content_box",
        "padding_ltrb"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rendered",
            "generated",
            "none"
          ]
        },
        "video": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^media/[A-Za-z0-9][A-Za-z0-9_-]*\\.mp4$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "num_frames": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "video",
        "reason",
        "num_frames",
        "fps",
        "duration_seconds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "video": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "num_frames": {
                "type": "null"
              },
              "fps": {
                "type": "null"
              },
              "duration_seconds": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "video": {
                "type": "string",
                "pattern": "^media/[A-Za-z0-9][A-Za-z0-9_-]*\\.mp4$"
              },
              "reason": {
                "type": "null"
              },
              "num_frames": {
                "type": "integer",
                "minimum": 1
              },
              "fps": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^n[0-9]{4,}$"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^n[0-9]{4,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "place_id": {
          "type": "string",
          "pattern": "^p[0-9]{4,}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "pose": {
          "$ref": "#/$defs/pose"
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "panorama": {
          "type": "string",
          "pattern": "^media/[A-Za-z0-9][A-Za-z0-9_-]*\\.png$"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^media/[A-Za-z0-9][A-Za-z0-9_-]*\\.png$"
        },
        "seam_status": {
          "enum": [
            "resolved",
            "seam_unresolved",
            "not_checked"
          ]
        }
      },
      "required": [
        "id",
        "parent_id",
        "place_id",
        "revision",
        "pose",
        "viewport",
        "panorama",
        "endpoint",
        "seam_status"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a[0-9]{4,}$"
        },
        "from": {
          "type": "string",
          "pattern": "^n[0-9]{4,}$"
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^n[0-9]{4,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "rotate",
              "revisit",
              "navigate",
              "local_edit",
              "global_change",
              "subject_action"
            ]
          }
        },
        "status": {
          "enum": [
            "accepted",
            "held",
            "failed"
          ]
        },
        "semantic": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN",
            "NOT_CHECKED"
          ]
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "label",
        "operations",
        "status",
        "semantic",
        "presentation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "to": {
                "type": "string",
                "pattern": "^n[0-9]{4,}$"
              },
              "semantic": {
                "enum": [
                  "PASS",
                  "UNCERTAIN"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "semantic": {
                "enum": [
                  "FAIL",
                  "NOT_CHECKED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "to": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "to": {
                "type": "string",
                "pattern": "^n[0-9]{4,}$"
              }
            }
          }
        }
      ]
    }
  }
}
